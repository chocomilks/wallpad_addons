{
  "name": "Doorface 현관 얼굴인식",
  "version": "0.1.0",
  "slug": "doorface",
  "description": "코맥스 월패드 세대현관 카메라로 얼굴을 인식해 문을 여는 애드온 (망고 SSH → adb 경유)",
  "url": "https://github.com/chocomilks/wallpad_addons/tree/master/doorface",
  "arch": ["amd64"],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:face-recognition",
  "panel_title": "현관 얼굴인식",
  "homeassistant_api": true,
  "services": ["mqtt:want"],
  "options": {
    "model": "buffalo_l",
    "log_level": "INFO"
  },
  "schema": {
    "model": "list(buffalo_l|buffalo_s)",
    "log_level": "list(DEBUG|INFO|WARNING)"
  }
}
